# Image versions the installer pins in .env. The release workflow sets DPM_WALLET_MANAGER_TAG to
# the version being released, both tags to <version>@sha256:<digest>, and RELEASE_VERSION;
# DPM_WALLET_TAG is bumped here by hand, after testing the pair.
# MIN_UPGRADE_FROM is the oldest installed version that may upgrade straight to this release
# (empty: no minimum).
DPM_WALLET_TAG=0.1.0
DPM_WALLET_MANAGER_TAG=main
# Postgres, pinned by index digest; the release workflow re-resolves it with the app images.
POSTGRES_TAG=18-trixie@sha256:edb0c08dc33befd0262ab3b5cf1c4f3f8cfd8b09e88c05b45adee29d6761ddb6
RELEASE_VERSION=
MIN_UPGRADE_FROM=
