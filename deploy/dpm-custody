#!/usr/bin/env bash
# Day-to-day commands for a DPM custody install. Run from anywhere: it works in its own folder.
#
#   ./dpm-custody start        start everything (also after a reboot, if Docker does not)
#   ./dpm-custody stop         stop everything; nothing is deleted
#   ./dpm-custody status       what is running
#   ./dpm-custody setup        set up, or see where setup stands (safe to run again)
#   ./dpm-custody support      write a report to send to support (no secrets in it)
#   ./dpm-custody logs [svc]   recent logs (all services, or one)
#   ./dpm-custody backup       save the databases and configuration into ./backups, encrypted
#                              to the backup recovery key (keeps the newest 5; see
#                              DPM_CUSTODY_KEEP_BACKUPS)
#   ./dpm-custody backup-key   create the backup recovery key on an install made without one
#   ./dpm-custody backup-open FILE.sealed
#                              decrypt one sealed backup file to the screen/pipe (asks for the key)
#   ./dpm-custody backup-kit   print the backup kit again
#   ./dpm-custody upgrade [version] [--yes]
#                              move to the newest version (or to that version): checks the
#                              download, backs up, and rolls back by itself if it does not come up
#   ./dpm-custody rollback     undo the last upgrade (images and files; never the databases)
#   ./dpm-custody cleanup-legacy [--yes]
#                              after an upgrade from a version before the config volume split:
#                              empty the old config volume (this makes a rollback to that
#                              version impossible)
set -euo pipefail

cd "$(dirname "$0")"

compose() { docker compose --env-file .env -f compose.yml "$@"; }

# env_value KEY [FILE] prints KEY's value from .env (or FILE); the last one wins, as in compose.
env_value() { sed -n "s/^$1=//p" "${2:-.env}" | tail -n 1; }

# cmd_support writes everything support needs into one file, with keys masked: setup's own report
# (checklist, journal, service checks) plus what only the host knows (Docker, containers, logs).
# The file is created owner-only (umask 077), not made so afterwards, and every value that the
# install's own configuration marks as a secret is masked wherever it appears. It runs in a
# subshell, so the secrets list is removed and the umask put back however it ends.
cmd_support() (
  umask 077
  local file secrets partial=""
  file="support-$(date +%Y%m%d-%H%M%S).txt"
  secrets="$(mktemp)"
  trap 'rm -f "$secrets"' EXIT
  if ! collect_secrets >"$secrets"; then
    partial="WARNING: the install's secrets could not be read (is Docker running?), so only the keys and 64-digit hex values in this report are masked; other secrets may show."
    echo "$partial" >&2
  fi
  echo "Writing $file ..."
  {
    echo "DPM custody support report"
    echo "Send this file to the platform team. It holds no keys: they are shown masked."
    [ -z "$partial" ] || echo "$partial"
    echo
    echo "== Host =="
    echo "OS:               $(uname -srm)"
    echo "Docker:           $(docker version --format '{{.Server.Version}}' 2>&1)"
    echo "Docker Compose:   $(docker compose version --short 2>&1)"
    echo "Install folder:   $(pwd)"
    echo "Image versions:   dpm-wallet $(env_value DPM_WALLET_TAG), dpm-wallet-manager $(env_value DPM_WALLET_MANAGER_TAG)"
    echo
    echo "== Containers =="
    compose ps -a 2>&1
    echo
    compose exec -T setup node dist/setup/main support 2>&1 || echo "(setup did not answer)"
    for service in setup dpm-wallet dpm-wallet-manager postgres; do
      echo
      echo "== Logs: $service (last 200 lines) =="
      compose logs --no-color --tail 200 "$service" 2>&1
    done
  } | mask_secrets "$secrets" | mask_keys >"$file"
  chmod 600 "$file"
  echo "Done. Send $(pwd)/$file to the platform team."
)

# collect_secrets prints, one per line, the secret values this install is configured with: the
# database password from .env, and every value in the services' env files whose name says key,
# secret, password or token, plus the password inside each DATABASE_URL (these hold the database
# role passwords). Passwords are marked with a leading "!" so they are hidden entirely, not
# partly. The env files are read in a throwaway `config-reader` container (read-only view of the
# configuration volumes, no network, no log driver: nothing it prints is kept by Docker), so it
# works with the stack stopped. Fails when it cannot.
collect_secrets() {
  local pw
  pw="$(env_value POSTGRES_PASSWORD)"
  [ -z "$pw" ] || printf '!%s\n' "$pw"
  compose run --rm --no-deps -T config-reader \
    sh -c 'cat /config-wallet/*.env /config-manager/*.env 2>/dev/null; true' | awk '
    {
      i = index($0, "="); if (i < 2) next
      name = substr($0, 1, i - 1); val = substr($0, i + 1)
      sub(/^\047/, "", val); sub(/\047$/, "", val)
      if (name ~ /PASSWORD/) print "!" val
      else if (name ~ /(KEY|SECRET|TOKEN)/ && name !~ /_ENV$/) print val
      if (name ~ /URL/ && val ~ /:\/\/[^:@\/]*:[^@\/]*@/) {
        u = val; sub(/^[^:]*:\/\/[^:@\/]*:/, "", u); sub(/@.*/, "", u); print "!" u
      }
    }'
}

# mask_secrets FILE masks every value listed in FILE (one per line) wherever it appears, and any
# run of 64 or more hex digits (encryption keys are 64 hex; so are transaction hashes, which are
# masked too) unless it is an image digest (sha256:...). A value shows only its last 4 characters
# when long; a line starting with "!" (a password) is hidden entirely.
mask_secrets() {
  awk -v secrets="$1" '
    function shown(v, full) { return (!full && length(v) >= 16) ? "…" substr(v, length(v) - 3) : "***" }
    BEGIN {
      while ((getline line < secrets) > 0) {
        full[n + 1] = 0
        if (substr(line, 1, 1) == "!") { line = substr(line, 2); full[n + 1] = 1 }
        if (length(line) >= 6) vals[++n] = line
      }
      close(secrets)
    }
    {
      for (k = 1; k <= n; k++) {
        v = vals[k]; out = ""; rest = $0
        while ((p = index(rest, v)) > 0) { out = out substr(rest, 1, p - 1) shown(v, full[k]); rest = substr(rest, p + length(v)) }
        $0 = out rest
      }
      out = ""; rest = $0
      while (match(rest, /[0-9a-fA-F]+/)) {
        run = substr(rest, RSTART, RLENGTH); before = substr(rest, 1, RSTART - 1)
        seen = out before
        if (RLENGTH >= 64 && substr(seen, length(seen) - 6) != "sha256:") run = "…" substr(run, length(run) - 3)
        out = out before run; rest = substr(rest, RSTART + RLENGTH)
      }
      print out rest
    }'
}

# mask_keys hides any key that may still appear in a service log, keeping its last 4 characters.
mask_keys() {
  sed -E \
    -e 's/bld_sk_[A-Za-z0-9_-]*([A-Za-z0-9_-]{4})/bld_sk_…\1/g' \
    -e 's/(dpmm_[a-z0-9]+_[a-z]{2}_)[a-z0-9]*([a-z0-9]{4})/\1…\2/g' \
    -e 's/dpmw_[a-f0-9]*([a-f0-9]{4})/dpmw_…\1/g' \
    -e 's/dpmbk_key_[A-Za-z0-9_-]*([A-Za-z0-9_-]{4})/dpmbk_key_…\1/g'
}

# backup_recipient prints the public key backups are sealed to: DPM_BACKUP_RECIPIENT in .env, else
# the one setup holds (made at install), which it then copies into .env. Prints nothing when the
# install has no key. It fails (non-zero) when setup cannot be asked: a backup must not quietly turn
# into a plaintext one because a container is down. An image too old to know the command (exit 2)
# means no key.
backup_recipient() {
  local r rc
  r="$(env_value DPM_BACKUP_RECIPIENT)"
  if [ -n "$r" ]; then
    printf '%s' "$r"
    return 0
  fi
  rc=0
  r="$(compose exec -T setup node dist/setup/main backup-recipient 2>/dev/null)" || rc=$?
  case "$rc" in
    0) ;;
    2) return 0 ;;
    *) return 1 ;;
  esac
  r="$(printf '%s' "$r" | tr -d '\r\n')"
  if [ -n "$r" ]; then set_env DPM_BACKUP_RECIPIENT "$r"; fi
  printf '%s' "$r"
}

# sync_backup_recipient copies the recipient setup made into .env, once, so finding it later does
# not depend on setup running. Quiet; never fails the command that called it.
sync_backup_recipient() {
  [ -z "$(env_value DPM_BACKUP_RECIPIENT)" ] || return 0
  backup_recipient >/dev/null 2>&1 || true
  return 0
}

# save_artifact DIR NAME RECIPIENT reads stdin into DIR/NAME, or DIR/NAME.sealed when RECIPIENT is
# set: encrypted inside the setup container, so the plaintext never touches this disk.
save_artifact() {
  if [ -n "$3" ]; then
    # --require-input: an empty dump or tar (a failed one) is refused, not sealed into a 74-byte file.
    DPM_BACKUP_RECIPIENT="$3" compose exec -T -e DPM_BACKUP_RECIPIENT setup node dist/setup/main backup-seal --require-input >"$1/$2.sealed"
  else
    cat >"$1/$2"
  fi
}

# prune_backups keeps the newest DPM_CUSTODY_KEEP_BACKUPS (default 5) complete backups and removes
# the rest. Only called after a backup succeeded, so a failing backup never costs the old ones.
prune_backups() {
  local keep="${DPM_CUSTODY_KEEP_BACKUPS:-5}" current="${1:-}" old d
  case "$keep" in '' | *[!0-9]*) keep=0 ;; *) keep=$((10#$keep)) ;; esac
  if [ "$keep" -lt 1 ]; then
    echo "DPM_CUSTODY_KEEP_BACKUPS must be a number of 1 or more; not pruning." >&2
    return 0
  fi
  old="$(for d in backups/[0-9]*; do case "$d" in *-incomplete) ;; *) [ -d "$d" ] && printf '%s\n' "$d" ;; esac; done |
    sort | awk -v k="$keep" '{ line[NR] = $0 } END { for (i = 1; i <= NR - k; i++) print line[i] }')" || return 0
  for d in $old; do
    [ "$d" != "$current" ] || continue # never the backup just made
    case "$d" in backups/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]) ;; *) continue ;; esac
    rm -rf "$d" && echo "Removed old backup $d (keeping the newest $keep)."
  done
}

# cmd_backup saves the databases, the configuration and the wallet data directory into
# backups/<stamp>/ and sets BACKUP_DIR. Each is encrypted to the backup recovery key when the
# install has one (files end in .sealed); otherwise they are plaintext, with a warning. Each step is
# checked, so it also fails cleanly inside `if` (where set -e is off).
BACKUP_DIR=""
cmd_backup() {
  local stamp dir user recipient sfx
  stamp="$(date +%Y%m%d-%H%M%S)"
  user="$(env_value POSTGRES_USER)"
  dir="backups/$stamp"
  recipient="$(backup_recipient)" || {
    echo "Could not find out whether this install encrypts its backups (is the setup service running?)." >&2
    echo "Nothing was backed up. Run ./dpm-custody start, then try again." >&2
    return 1
  }
  sfx=""
  if [ -n "$recipient" ]; then
    sfx=".sealed"
  else
    echo "WARNING: this install has no backup recovery key, so this backup is NOT encrypted." >&2
    echo "         Run ./dpm-custody backup-key to create one; later backups are then encrypted." >&2
  fi
  mkdir -p "$dir" && chmod 700 backups "$dir" || { echo "Could not create $(pwd)/$dir." >&2; return 1; }
  echo "Saving databases..."
  compose exec -T postgres pg_dumpall -U "${user:-dpm}" | save_artifact "$dir" databases.sql "$recipient" && [ -s "$dir/databases.sql$sfx" ] ||
    { backup_failed "$dir" "the databases"; return 1; }
  echo "Saving configuration and wallet data..."
  # Three volumes since the config split (config-wallet, config-manager, setup-state); an install
  # whose setup container still has the single /config volume is saved as it was.
  compose exec -T setup sh -c "if grep -q ' /config-wallet ' /proc/mounts; then tar -C / -czf - config-wallet config-manager state; else tar -C / -czf - config; fi" | save_artifact "$dir" config.tar.gz "$recipient" && [ -s "$dir/config.tar.gz$sfx" ] ||
    { backup_failed "$dir" "the configuration"; return 1; }
  compose exec -T dpm-wallet tar -C / -czf - data | save_artifact "$dir" wallet-data.tar.gz "$recipient" && [ -s "$dir/wallet-data.tar.gz$sfx" ] ||
    { backup_failed "$dir" "the wallet data"; return 1; }
  save_artifact "$dir" installer.env "$recipient" <.env && chmod 600 "$dir"/* || { backup_failed "$dir" ".env"; return 1; }
  BACKUP_DIR="$dir"
  echo "Backup saved in $(pwd)/$dir"
  if [ -n "$recipient" ]; then
    echo "It is encrypted: opening it needs the backup recovery key shown at setup (backup-open)."
  fi
  echo "Copy that folder somewhere off this machine. It contains secrets: keep it private."
  prune_backups "$dir"
}

# read_recovery_key prints the backup recovery key from DPM_BACKUP_RECOVERY_KEY_FILE, or asks for
# it without echoing. It never goes on a command line.
read_recovery_key() {
  local key
  if [ -n "${DPM_BACKUP_RECOVERY_KEY_FILE:-}" ]; then
    [ -r "$DPM_BACKUP_RECOVERY_KEY_FILE" ] || { echo "DPM_BACKUP_RECOVERY_KEY_FILE ($DPM_BACKUP_RECOVERY_KEY_FILE) is not a readable file." >&2; return 1; }
    tr -d ' \r\n' <"$DPM_BACKUP_RECOVERY_KEY_FILE"
    return 0
  fi
  [ -r /dev/tty ] || { echo "No terminal to ask in. Put the key in a file and set DPM_BACKUP_RECOVERY_KEY_FILE." >&2; return 1; }
  read -r -s -p "Backup recovery key (not shown as you type): " key </dev/tty >&2 || return 1
  echo >&2
  printf '%s' "$key" | tr -d ' \r\n'
}

# cmd_backup_open FILE decrypts one sealed backup file to standard output, in a one-off `tools`
# container (no log driver: nothing it prints reaches Docker's logs), so it works while the stack is
# stopped. The recovery key travels as the first line of its standard input, never in an argument or
# an environment variable. The file is decrypted twice: a first pass to nowhere proves the whole file
# authentic, so a truncated or altered one is refused before any byte is released to whatever reads
# the output (decrypted data otherwise streams out before the final check).
cmd_backup_open() {
  local file="${1:-}" key
  [ -n "$file" ] && [ -f "$file" ] || { echo "Usage: ./dpm-custody backup-open backups/<stamp>/<file>.sealed" >&2; return 2; }
  key="$(read_recovery_key)" || return 1
  [ -n "$key" ] || { echo "No key given." >&2; return 1; }
  if ! { printf '%s\n' "$key"; cat "$file"; } | compose run --rm --no-deps -T tools node dist/setup/main backup-open --key-stdin >/dev/null; then
    echo "The backup could not be opened: wrong recovery key, or the file is damaged or incomplete. Nothing was output." >&2
    return 1
  fi
  { printf '%s\n' "$key"; cat "$file"; } | compose run --rm --no-deps -T tools node dist/setup/main backup-open --key-stdin
}

# cmd_backup_key creates the backup recovery key on an install that has none: its public half goes
# into .env (DPM_BACKUP_RECIPIENT), its private half is shown once and not kept. --rotate replaces an
# existing key; older backups stay readable only with the key they were sealed to.
cmd_backup_key() {
  local out recipient recovery answer existing
  existing="$(backup_recipient)" || { echo "Could not ask the setup service (is it running?). Run ./dpm-custody start first." >&2; return 1; }
  if [ -n "$existing" ] && [ "${1:-}" != --rotate ]; then
    echo "This install already has a backup recovery key (backups are encrypted)."
    echo "./dpm-custody backup-key --rotate makes a new one; backups made before stay readable only with the old key."
    return 0
  fi
  out="$(compose run --rm --no-deps -T tools node dist/setup/main backup-keygen)" || { echo "Could not create the key." >&2; return 1; }
  recipient="$(printf '%s\n' "$out" | sed -n 's/^recipient=//p' | tr -d '\r')"
  recovery="$(printf '%s\n' "$out" | sed -n 's/^recovery_key=//p' | tr -d '\r')"
  [ -n "$recipient" ] && [ -n "$recovery" ] || { echo "Could not create the key." >&2; return 1; }
  set_env DPM_BACKUP_RECIPIENT "$recipient"
  echo
  echo "Backup recovery key (shown once; this machine does not keep it):"
  echo
  echo "    $recovery"
  echo
  echo "Copy it somewhere safe and private, such as a password manager. Backups from now on are"
  echo "encrypted so that only this key opens them; without it they cannot be read."
  if [ -t 0 ]; then
    read -r -p "Press Enter once you have saved it. " answer || true
  fi
}

# backup_failed DIR WHAT marks a half-written backup so it is never mistaken for a good one.
backup_failed() {
  chmod 600 "$1"/* 2>/dev/null || true
  mv "$1" "$1-incomplete" 2>/dev/null || true
  echo "The backup failed while saving $2. The incomplete files are in $(pwd)/$1-incomplete." >&2
}

# ---- upgrade and rollback --------------------------------------------------------------------
#
# upgrade, in order (every step before "switch" changes nothing in the install):
#   download the release into upgrade.tmp/ and check it against SHA256SUMS; check the versions,
#   that the stack is healthy now and that there is room on disk; ask; back up; pull the new
#   images while the old ones keep running; keep the old files as *.prev (mode 600); switch the
#   files and .env, `up -d`; wait for health. If it does not come up, roll back by itself.
# rollback puts back compose.yml and dpm-custody from *.prev, and in .env only the image tags and
# DPM_CUSTODY_VERSION, then `up -d` and the same health wait. It never restores a database.

# >>> release public key >>>
# PLACEHOLDER: no private key exists for this one. Replace it with the real key (see
# scripts/release-signing-key.sh) in install.sh, install.ps1 and dpm-custody; until then no
# release can be verified, so none can be installed or upgraded to.
RELEASE_KEY_IS_PLACEHOLDER=1
RELEASE_PUBKEY='-----BEGIN PUBLIC KEY-----
MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEAmHIZwcph401VXfbdEQCsT5VUeke
b/nekspBGcW/P3518k+tqluQyqTRi8Y7R7jA6zxSdQwNYVFy41HokCfzCQ==
-----END PUBLIC KEY-----'
# <<< release public key <<<

REPO_RELEASES="https://github.com/In-a-bit/dpm-wallet-manager/releases"
STAGE="upgrade.tmp"
# The .env keys an upgrade changes, and the only ones a rollback puts back.
VERSION_KEYS="DPM_WALLET_TAG DPM_WALLET_MANAGER_TAG POSTGRES_TAG DPM_CUSTODY_VERSION"
UPGRADE_PHASE=""
# upgrade.log keeps every message of an upgrade or rollback, plus the Docker output, so the
# outcome survives a closed terminal. upgrade.inprogress marks a switch that has not finished.
# upgrade.lock (a folder) stops two upgrades or rollbacks from running at once.
UPGRADE_LOG=""
MARKER="upgrade.inprogress"
LOCKED=0

# say prints a message and adds it to upgrade.log during an upgrade or rollback. It never fails:
# after a dropped SSH session the terminal is gone and writes to it error out.
say() {
  printf '%s\n' "$*" 2>/dev/null || true
  if [ -n "$UPGRADE_LOG" ]; then printf '%s\n' "$*" >>"$UPGRADE_LOG" 2>/dev/null || true; fi
}

# start_log COMMAND opens upgrade.log (mode 600) for this run.
start_log() {
  UPGRADE_LOG="upgrade.log"
  (umask 077 && touch "$UPGRADE_LOG") 2>/dev/null || true
  printf '\n== %s started %s ==\n' "$1" "$(date '+%Y-%m-%d %H:%M:%S %z')" >>"$UPGRADE_LOG" 2>/dev/null || true
}

# take_lock refuses when another upgrade or rollback holds upgrade.lock.
take_lock() {
  if mkdir upgrade.lock 2>/dev/null; then
    LOCKED=1
    echo "$$" >upgrade.lock/pid 2>/dev/null || true
    return 0
  fi
  say ""
  say "  ✕ Another upgrade or rollback is running in this folder (process $(cat upgrade.lock/pid 2>/dev/null || echo unknown))."
  say "    Nothing was changed. If none is running (for example the machine restarted during one),"
  say "    remove the folder $(pwd)/upgrade.lock and try again."
  say ""
  exit 1
}

# marker_hint prints what to do about an unfinished upgrade, if there is one.
marker_hint() {
  [ -f "$MARKER" ] || return 0
  say ""
  say "  ! An upgrade did not finish (from $(env_value from "$MARKER") to $(env_value to "$MARKER"), started $(env_value started "$MARKER"))."
  say "    Its log is $(pwd)/upgrade.log. Run ./dpm-custody rollback to return to the previous"
  say "    version (that clears this note), then ./dpm-custody support if anything is unclear."
  say ""
}

# storage_line prints one line about the disk, from the manager's readiness answer:
#   Storage: <level> · <used>% used · ~<days> days to full
# Parts that are unknown are left out. When the manager does not answer, or has no storage sample
# yet, it prints nothing: status must never fail because of this.
storage_line() {
  local out level used days line
  out="$(compose exec -T dpm-wallet-manager node -e 'fetch("http://127.0.0.1:3000/v1/health/ready").then(r=>r.json()).then(b=>{const s=b.storage;if(s)console.log([s.level,s.usedPercent,s.daysToFull].map(v=>v==null?"":v).join("|"))}).catch(()=>{})' 2>/dev/null)" || return 0
  out="$(printf '%s\n' "$out" | tail -n 1)"
  IFS='|' read -r level used days <<<"$out" || true
  case "$level" in ok | warning | critical) ;; *) return 0 ;; esac
  line="Storage: $level"
  case "$used" in '' | *[!0-9.]*) ;; *) line="$line · ${used}% used" ;; esac
  case "$days" in '' | *[!0-9.]*) ;; *) line="$line · ~${days} days to full" ;; esac
  say "$line"
}

# stop_unchanged MESSAGE... ends an upgrade before anything in the install was changed.
stop_unchanged() {
  local line
  say ""
  say "  ✕ $1"
  shift
  for line in "$@"; do say "    $line"; done
  say "    Nothing was changed: the install keeps running as it was."
  say ""
  exit 1
}

health_timeout() {
  local t="${DPM_CUSTODY_HEALTH_TIMEOUT:-300}"
  case "$t" in '' | *[!0-9]*) t=300 ;; esac
  printf '%s' "$t"
}

# duration SECONDS prints "5 minutes" or "90 seconds".
duration() {
  if [ "$1" -ge 60 ] && [ $(($1 % 60)) -eq 0 ]; then printf '%s minutes' $(($1 / 60)); else printf '%s seconds' "$1"; fi
}

# ver_core V prints the x.y.z of V (a leading v and a -suffix / +suffix are ignored).
ver_core() {
  local v="${1#v}"
  v="${v%%[-+]*}"
  [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  printf '%s' "$v"
}

# ver_cmp A B prints -1, 0 or 1 comparing two x.y.z numerically.
ver_cmp() {
  local a b i x y
  IFS=. read -r -a a <<<"$1"
  IFS=. read -r -a b <<<"$2"
  for i in 0 1 2; do
    x=$((10#${a[$i]}))
    y=$((10#${b[$i]}))
    if [ "$x" -lt "$y" ]; then echo -1; return; fi
    if [ "$x" -gt "$y" ]; then echo 1; return; fi
  done
  echo 0
}

valid_tag() { [[ "$1" =~ ^[A-Za-z0-9._-]+(@sha256:[a-f0-9]{64})?$ ]]; }
valid_version() { [[ "$1" =~ ^v?[0-9A-Za-z.+-]+$ ]] && ver_core "$1" >/dev/null; }

# ps_states reads `docker compose ps --format json` (one object per line, or one array,
# depending on the Compose version) and prints "service state health" per container, with "-"
# for no healthcheck. Pure shell tools: it must work when every container is down.
ps_states() {
  tr -d '\n' | grep -oE '"(Service|State|Health)":"[^"]*"' | awk -F'"' '
    function flush() {
      if (n) print (s == "" ? "?" : s), (st == "" ? "?" : st), (h == "" ? "-" : h)
      s = ""; st = ""; h = ""; hs = 0; ss = 0; sts = 0; n = 0
    }
    {
      k = $2; v = $4
      if ((k == "Service" && ss) || (k == "State" && sts) || (k == "Health" && hs)) flush()
      if (k == "Service") { s = v; ss = 1 } else if (k == "State") { st = v; sts = 1 } else { h = v; hs = 1 }
      n = 1
    }
    END { flush() }'
}

# stack_healthy is true when every service in compose.yml has a container, every container with
# a healthcheck is healthy and every other one is running. The health gate uses the same test.
stack_healthy() {
  local services states svc lines svc_ state health
  services="$(compose config --services 2>/dev/null)" || return 1
  [ -n "$services" ] || return 1
  states="$(compose ps -a --format json 2>/dev/null | ps_states)" || return 1
  for svc in $services; do
    lines="$(printf '%s\n' "$states" | awk -v s="$svc" '$1 == s')"
    [ -n "$lines" ] || return 1
    while read -r svc_ state health; do
      [ "$state" = running ] || return 1
      case "$health" in - | healthy) ;; *) return 1 ;; esac
    done <<<"$lines"
  done
  return 0
}

# not_healthy_list prints the services that are not healthy, for messages.
not_healthy_list() {
  compose ps -a --format json 2>/dev/null | ps_states |
    awk '$2 != "running" || ($3 != "-" && $3 != "healthy") { printf "%s%s (%s%s)", sep, $1, $2, ($3 == "-" ? "" : ", " $3); sep = ", " }'
}

# health_gate waits up to the health timeout (DPM_CUSTODY_HEALTH_TIMEOUT, default 300 s) for
# stack_healthy, checking every 5 seconds.
health_gate() {
  local timeout waited=0
  timeout="$(health_timeout)"
  say "Waiting for every service to be healthy (up to $(duration "$timeout")) ..."
  while :; do
    if stack_healthy; then return 0; fi
    if [ "$waited" -ge "$timeout" ]; then
      say "  Still not healthy after ${timeout} s: $(not_healthy_list)"
      return 1
    fi
    sleep 5
    waited=$((waited + 5))
    if [ $((waited % 30)) -eq 0 ]; then say "  ... ${waited} s"; fi
  done
}

releases_base() {
  if [ -n "${DPM_CUSTODY_RELEASES_URL:-}" ]; then
    printf '%s' "${DPM_CUSTODY_RELEASES_URL%/}"
  elif [ "$1" = latest ]; then
    printf '%s' "$REPO_RELEASES/latest/download"
  else
    printf '%s' "$REPO_RELEASES/download/$1"
  fi
}

# sha_check runs the available checksum tool over a sums file, in the staging folder.
sha_check() {
  if command -v sha256sum >/dev/null 2>&1; then
    (cd "$STAGE" && sha256sum -c "$1") >/dev/null 2>&1
  elif command -v shasum >/dev/null 2>&1; then
    (cd "$STAGE" && shasum -a 256 -c "$1") >/dev/null 2>&1
  else
    stop_unchanged "Neither sha256sum nor shasum is available to check the download."
  fi
}

# fetch_one BASE NAME downloads one release file into upgrade.tmp/. Only https:// is accepted
# (DPM_CUSTODY_ALLOW_INSECURE=1 allows file:// and http:// for a local rehearsal).
fetch_one() {
  local url="$1/$2"
  case "$url" in
    https://*) curl -fsSL --proto '=https' --tlsv1.2 "$url" -o "$STAGE/$2" 2>/dev/null ;;
    *)
      [ "${DPM_CUSTODY_ALLOW_INSECURE:-}" = 1 ] ||
        stop_unchanged "Refusing to download from $url: releases are fetched over https:// only." \
          "(DPM_CUSTODY_ALLOW_INSECURE=1 allows file:// and http:// for a local rehearsal; never use it on a real install.)"
      curl -fsSL "$url" -o "$STAGE/$2" 2>/dev/null
      ;;
  esac
}

# verify_signature checks SHA256SUMS against SHA256SUMS.sig with the public key embedded in this
# (the installed) dpm-custody, or DPM_CUSTODY_RELEASE_PUBKEY (a PEM file) for a rehearsal. The new
# release's own script is never trusted to check itself.
verify_signature() {
  command -v openssl >/dev/null 2>&1 ||
    stop_unchanged "openssl is needed to check the release signature and was not found."
  if [ -n "${DPM_CUSTODY_RELEASE_PUBKEY:-}" ]; then
    [ -r "$DPM_CUSTODY_RELEASE_PUBKEY" ] ||
      stop_unchanged "DPM_CUSTODY_RELEASE_PUBKEY ($DPM_CUSTODY_RELEASE_PUBKEY) is not a readable file."
    cp "$DPM_CUSTODY_RELEASE_PUBKEY" "$STAGE/release.pub"
  else
    printf '%s\n' "$RELEASE_PUBKEY" >"$STAGE/release.pub"
  fi
  if ! openssl dgst -sha256 -verify "$STAGE/release.pub" -signature "$STAGE/SHA256SUMS.sig" "$STAGE/SHA256SUMS" >/dev/null 2>&1; then
    if [ "$RELEASE_KEY_IS_PLACEHOLDER" = 1 ] && [ -z "${DPM_CUSTODY_RELEASE_PUBKEY:-}" ]; then
      stop_unchanged "This dpm-custody still carries a placeholder release key, so no signature can be valid." \
        "Tell the platform team."
    fi
    stop_unchanged "The release's signature (SHA256SUMS.sig) does not match its SHA256SUMS." \
      "Do not use this download; tell the platform team."
  fi
}

# fetch_release BASE downloads the release files into upgrade.tmp/, checks the signature on its
# SHA256SUMS, then the files against it. An upgrade requires both SHA256SUMS and its signature.
fetch_release() {
  local base="$1" f line
  rm -rf "$STAGE"
  (umask 077 && mkdir "$STAGE") || stop_unchanged "Could not create $(pwd)/$STAGE."
  for f in compose.yml versions.env dpm-custody; do
    fetch_one "$base" "$f" ||
      stop_unchanged "Could not download $f from $base." "Check the internet connection and the version name, then try again."
  done
  fetch_one "$base" SHA256SUMS ||
    stop_unchanged "This release has no readable SHA256SUMS ($base/SHA256SUMS), so the download cannot be checked and the upgrade stops." \
      "Ask the platform team for a release that has one."
  fetch_one "$base" SHA256SUMS.sig ||
    stop_unchanged "This release has no readable signature ($base/SHA256SUMS.sig), so the download cannot be trusted and the upgrade stops." \
      "Ask the platform team for a release that has one."
  [ -s "$STAGE/SHA256SUMS" ] || stop_unchanged "SHA256SUMS was downloaded but is empty."
  [ -s "$STAGE/SHA256SUMS.sig" ] || stop_unchanged "SHA256SUMS.sig was downloaded but is empty."
  verify_signature
  : >"$STAGE/SHA256SUMS.use"
  for f in compose.yml versions.env dpm-custody; do
    line="$(grep -E "^[0-9a-fA-F]{64}  \*?$f\$" "$STAGE/SHA256SUMS" | head -n 1 || true)"
    [ -n "$line" ] || stop_unchanged "SHA256SUMS has no entry for $f."
    printf '%s\n' "$line" >>"$STAGE/SHA256SUMS.use"
  done
  sha_check SHA256SUMS.use ||
    stop_unchanged "A downloaded file does not match SHA256SUMS." "Try again; if it keeps failing, tell the platform team."
  bash -n "$STAGE/dpm-custody" 2>/dev/null || stop_unchanged "The downloaded dpm-custody script is not valid."
}

# check_disk refuses when free disk is below twice the databases' size plus 1 GB.
check_disk() {
  local user bytes free_kb need_kb
  user="$(env_value POSTGRES_USER)"
  bytes="$(compose exec -T postgres psql -U "${user:-dpm}" -d postgres -Atc \
    "SELECT COALESCE(SUM(pg_database_size(datname)), 0) FROM pg_database WHERE NOT datistemplate" 2>/dev/null |
    tr -d '[:space:]')" || bytes=""
  case "$bytes" in '' | *[!0-9]*) stop_unchanged "Could not read the database size from postgres." "Run ./dpm-custody status and ./dpm-custody support." ;; esac
  free_kb="$(df -Pk . | awk 'NR == 2 { print $4 }')"
  case "$free_kb" in '' | *[!0-9]*) stop_unchanged "Could not read the free disk space here." ;; esac
  need_kb=$((bytes / 1024 * 2 + 1048576))
  if [ "$free_kb" -lt "$need_kb" ]; then
    stop_unchanged "Not enough free disk space: $((free_kb / 1024)) MB free, $((need_kb / 1024)) MB needed (twice the databases plus 1 GB)." \
      "Free up disk space on this machine, then try again."
  fi
}

# install_file SRC DST MODE puts SRC in place of DST with one rename, so DST is never half-written
# and a running dpm-custody keeps reading its own (old) file.
install_file() {
  cp "$1" ".$2.new" && chmod "$3" ".$2.new" && mv -f ".$2.new" "$2"
}

# keep_prev saves compose.yml, versions.env, .env and dpm-custody as *.prev, mode 600.
# All copies are written first and only then renamed, so an interruption cannot leave a mix of
# this upgrade's and an earlier upgrade's *.prev files.
keep_prev() {
  local f files=""
  for f in compose.yml versions.env .env dpm-custody; do
    [ -e "$f" ] || continue
    if ! { (umask 077 && cp "$f" ".$f.prev.new") && chmod 600 ".$f.prev.new"; }; then
      rm -f .compose.yml.prev.new .versions.env.prev.new ..env.prev.new .dpm-custody.prev.new
      return 1
    fi
    files="$files $f"
  done
  # A versions.env.prev from an earlier upgrade must not be restored over a folder without one.
  [ -e versions.env ] || rm -f versions.env.prev
  for f in $files; do mv -f ".$f.prev.new" "$f.prev" || return 1; done
}

# prev_value_ok KEY VALUE checks a value from .env.prev before it reaches set_env's sed.
prev_value_ok() {
  case "$1" in
    DPM_CUSTODY_VERSION) [ "$2" = unknown ] || valid_version "$2" ;;
    *) valid_tag "$2" ;;
  esac
}

have_prev() { [ -f compose.yml.prev ] && [ -f .env.prev ] && [ -f dpm-custody.prev ]; }
remove_prev() { rm -f compose.yml.prev versions.env.prev .env.prev dpm-custody.prev; }

# An upgrade overwrites the *.prev files of the upgrade before it. stash_prev copies them to
# *.prev.last first (mode 600), so that when this upgrade fails and rolls back by itself,
# unstash_prev can put them back and `rollback` still undoes the earlier, good upgrade.
PREV_FILES="compose.yml.prev versions.env.prev .env.prev dpm-custody.prev"
drop_stash() { rm -f compose.yml.prev.last versions.env.prev.last .env.prev.last dpm-custody.prev.last; }
stash_prev() {
  local f
  drop_stash
  have_prev || return 0
  for f in $PREV_FILES; do
    [ -e "$f" ] || continue
    (umask 077 && cp "$f" "$f.last") && chmod 600 "$f.last" || { drop_stash; return 1; }
  done
}
# unstash_prev replaces the *.prev files with the stashed ones, or just removes them when there is
# no stash (the usual case: nothing older to go back to).
unstash_prev() {
  local f
  remove_prev
  [ -f .env.prev.last ] || { drop_stash; return 0; }
  for f in $PREV_FILES; do
    if [ -e "$f.last" ]; then mv -f "$f.last" "$f" || return 1; fi
  done
}

# restore_prev puts the *.prev files back. In .env only the image tags and DPM_CUSTODY_VERSION
# go back to their .env.prev values (a key .env.prev did not have is removed); any other edit to
# .env since the upgrade is kept. dpm-custody goes back last.
restore_prev() {
  local k v
  install_file compose.yml.prev compose.yml 644 || return 1
  if [ -f versions.env.prev ]; then install_file versions.env.prev versions.env 644 || return 1; fi
  for k in $VERSION_KEYS; do
    if grep -q "^$k=" .env.prev; then
      v="$(env_value "$k" .env.prev)"
      if prev_value_ok "$k" "$v"; then
        set_env "$k" "$v" || return 1
      else
        say "  ! $k in .env.prev (\"$v\") is not a valid value, so it was not copied into .env."
        say "    Set $k in .env by hand to the version you ran before, then run ./dpm-custody start."
      fi
    else
      unset_env "$k" || return 1
    fi
  done
  install_file dpm-custody.prev dpm-custody 755 || return 1
}

latest_backup() { ls -1d backups/[0-9]*/ 2>/dev/null | grep -v -- '-incomplete/$' | tail -n 1 | sed 's|/$||'; }

# print_restore_steps is what to do when even the previous version does not come up. It never
# restores anything itself: restoring a database is the operator's decision.
print_restore_steps() {
  local b="${1:-$(latest_backup)}"
  b="${b:-backups/<stamp>}"
  say ""
  say "  ✕ The previous version did not come up healthy either. Nothing more is done automatically:"
  say "    the rows in the databases were not touched by the rollback (their text indexes are rebuilt"
  say "    when the Postgres image changes; if that failed, the services are stopped)."
  say "    1. Run ./dpm-custody support and send the file it writes to the platform team."
  say "    2. If the platform team asks you to restore the backup taken before the upgrade"
  say "       ($(pwd)/$b), follow \"Restoring a backup\" in the deploy README:"
  say "       stop the stack, start postgres alone, drop and re-create the two databases from"
  say "       $b/databases.sql (or databases.sql.sealed: ./dpm-custody backup-open prints it, with"
  say "       the backup recovery key), then ./dpm-custody start."
  say ""
}

# rollback_now restores the *.prev files, starts the stack and waits for health. Shared by
# `upgrade` (after a failed health gate) and `rollback`.
rollback_now() {
  local before after change=0
  # Which Postgres C library the install runs now, and which the previous version will. Read from
  # the compose files before anything is touched; if either cannot be read the rollback does not
  # start, rather than guess that nothing changes.
  before="$(pg_libc .env compose.yml)" && after="$(pg_libc .env.prev compose.yml.prev)" || {
    say "  ✕ Could not read the Postgres image from compose.yml / compose.yml.prev, so the rollback cannot tell"
    say "    whether the database's text indexes must be rebuilt. Nothing was changed."
    say "    Check that Docker and Docker Compose work (docker compose version), then try again."
    return 1
  }
  [ "$before" = "$after" ] || change=1
  [ ! -f "$REINDEX_PENDING" ] || change=1
  if [ "$change" = 1 ]; then
    # The text-index rebuild setup records is keyed by the Postgres C library it saw. Going back
    # to a release on the other library changes that, so forget the record while the current
    # setup container and its state volume are still in the compose.yml: the next upgrade then
    # rebuilds again, whichever dpm-custody drives it. Without that the next upgrade could start
    # on wrongly ordered indexes, so a failure here stops the rollback before it changes anything.
    if ! compose run --rm --no-deps -T setup rm -f /state/.collation-key >>"${UPGRADE_LOG:-/dev/null}" 2>&1; then
      say "  ✕ Could not reset the record of the last index rebuild (is Docker able to run the setup image?)."
      say "    Nothing was changed. Fix that, then try again."
      return 1
    fi
    # Written before anything is stopped or restored, removed only when every database is done:
    # if this is interrupted, `start`, the next rollback and the next upgrade see it.
    (umask 077 && printf '%s to %s\n' "$before" "$after" >"$REINDEX_PENDING") || {
      say "  ✕ Could not write $REINDEX_PENDING (is the disk full?). Nothing was changed."
      return 1
    }
  fi
  if ! restore_prev; then
    say "  ✕ Could not put the previous files back (see the message above)."
    return 1
  fi
  if [ -f "$REINDEX_PENDING" ]; then
    # Rows written under one C library's sort order sit in indexes ordered by the other's; a
    # Postgres on the other library reads them wrongly (missed rows, duplicate "unique" values).
    # So the services stay stopped until the indexes are rebuilt, and a failure stops the rollback.
    if [ "$before" = "$after" ]; then
      say "Finishing the text-index rebuild an earlier rollback left undone, before the services start ..."
    else
      say "The Postgres image changes ($before to $after): rebuilding its text indexes before the services start ..."
    fi
    if ! finish_pending_reindex; then
      return 1
    fi
  fi
  if ! compose up -d >>"${UPGRADE_LOG:-/dev/null}" 2>&1; then
    say "  ✕ Docker could not start the previous version (details in upgrade.log)."
    return 1
  fi
  # An older version now runs and may write the old config volume again, so the scrub of it that
  # was stamped as done must be done again by the next command of a newer dpm-custody.
  rm -f .legacy-scrubbed
  health_gate
}

# REINDEX_PENDING is the install-folder file that says a Postgres C library change still needs its
# text indexes rebuilt. `start`, `rollback` and `upgrade` all honour it.
REINDEX_PENDING=".reindex-pending"

# pg_libc [ENV_FILE COMPOSE_FILE] prints musl or glibc for the Postgres image those files name (the
# Alpine image is musl, anything else Debian/glibc). It fails when it cannot read the image.
pg_libc() {
  local image
  image="$(docker compose --env-file "${1:-.env}" -f "${2:-compose.yml}" config 2>/dev/null | sed -n 's/^ *image: \(postgres:.*\)$/\1/p' | head -n 1)"
  [ -n "$image" ] || return 1
  case "$image" in
    *alpine*) echo musl ;;
    *) echo glibc ;;
  esac
}

# finish_pending_reindex does the rebuild a pending marker asks for, with the services stopped, and
# removes the marker only when every database succeeded. Succeeds at once when nothing is pending.
finish_pending_reindex() {
  [ -f "$REINDEX_PENDING" ] || return 0
  if ! reindex_all_databases; then
    say "  ✕ Could not rebuild the databases' text indexes (details in ${UPGRADE_LOG:-reindex.log}). The services are stopped"
    say "    on purpose: they must not run on wrongly ordered indexes. Fix the cause, then run ./dpm-custody start,"
    say "    which finishes the rebuild first. ($(pwd)/$REINDEX_PENDING records that it is owed.)"
    return 1
  fi
  rm -f "$REINDEX_PENDING"
}

# reindex_all_databases stops the services that use Postgres, (re)starts it alone, and runs
# REINDEX DATABASE on every database that accepts connections. Everything is logged to upgrade.log.
reindex_all_databases() {
  local user dbs db i log="${UPGRADE_LOG:-reindex.log}"
  user="$(env_value POSTGRES_USER)"
  user="${user:-dpm}"
  (umask 077 && : >>"$log") 2>/dev/null || true
  compose stop dpm-wallet dpm-wallet-manager setup >>"$log" 2>&1 || true
  compose up -d --no-deps postgres >>"$log" 2>&1 || return 1
  for i in $(seq 1 60); do
    compose exec -T postgres pg_isready -U "$user" >/dev/null 2>&1 && break
    sleep 2
    [ "$i" -lt 60 ] || return 1
  done
  dbs="$(compose exec -T postgres psql -U "$user" -d postgres -tAc 'select datname from pg_database where datallowconn order by 1' 2>>"$log")" || return 1
  for db in $dbs; do
    case "$db" in *[!A-Za-z0-9_]*) continue ;; esac
    compose exec -T postgres psql -U "$user" -d "$db" -v ON_ERROR_STOP=1 -c "REINDEX DATABASE $db" >>"$log" 2>&1 || return 1
  done
}

on_upgrade_exit() {
  local rc=$?
  rm -rf "$STAGE" 2>/dev/null || true
  if [ "$rc" -ne 0 ]; then
    case "$UPGRADE_PHASE" in
      switched | rolling-back)
        say ""
        say "  ✕ The upgrade stopped part-way. The previous files are kept as *.prev."
        say "    Run ./dpm-custody rollback to go back to the previous version, then ./dpm-custody support."
        say ""
        ;;
    esac
  fi
  if [ "$LOCKED" = 1 ]; then rm -rf upgrade.lock 2>/dev/null || true; fi
}

prune_one_kept() { # TAG DIGEST REF... : true when the image is one of the REFs (tag or digest)
  local t="$1" d="$2" ref rt rd
  shift 2
  for ref in "$@"; do
    [ -n "$ref" ] || continue
    rt="${ref%%@*}"
    rd=""
    case "$ref" in *@*) rd="${ref#*@}" ;; esac
    if [ "$t" != "<none>" ] && [ "$t" = "$rt" ]; then return 0; fi
    if [ -n "$rd" ] && [ "$d" = "$rd" ]; then return 0; fi
  done
  return 1
}

# prune_images removes this install's dpm images other than the current and previous tags. It
# only names images of its own two repositories, never prunes anything else, and ignores failures
# (an image still used by a container is simply kept).
# image_in_use REPO TAG DIGEST ID is true when any container on this machine, running or
# stopped, of any install, was created from that image (by name, digest or image ID).
image_in_use() {
  local r="$1" t="$2" d="$3" id="$4" ref rest name rrepo rtag rd x
  while read -r ref; do
    [ -n "$ref" ] || continue
    [ "$ref" = "$id" ] && return 0
    rest="${ref%%@*}"
    rd=""
    case "$ref" in *@*) rd="${ref#*@}" ;; esac
    name="${rest##*/}"
    case "$name" in
      *:*) rtag="${name##*:}"; rrepo="${rest%:*}" ;;
      *) rtag=latest; rrepo="$rest" ;;
    esac
    [ "$rrepo" = "$r" ] || continue
    if [ "$t" != "<none>" ] && [ "$rtag" = "$t" ]; then return 0; fi
    if [ -n "$rd" ] && [ "$rd" = "$d" ]; then return 0; fi
  done <<<"$INUSE_REFS"
  while read -r x; do
    [ -n "$x" ] || continue
    x="${x#sha256:}"
    [ "${x:0:12}" = "${id#sha256:}" ] && return 0
  done <<<"$INUSE_IDS"
  return 1
}

prune_images() {
  local reg repo key cur prev list keep_ids r t d id cids
  local -a remove=()
  # Images used by any container on the host (another install shares these repositories) are
  # never removed. If the containers cannot be listed, nothing is removed.
  INUSE_REFS="$(docker ps -a --format '{{.Image}}' 2>/dev/null)" || { say "  (Older images were kept: could not list the containers.)"; return 0; }
  cids="$(docker ps -aq 2>/dev/null)" || { say "  (Older images were kept: could not list the containers.)"; return 0; }
  INUSE_IDS=""
  if [ -n "$cids" ]; then
    # shellcheck disable=SC2086
    INUSE_IDS="$(docker inspect --format '{{.Image}}' $cids 2>/dev/null)" ||
      { say "  (Older images were kept: could not inspect the containers.)"; return 0; }
  fi
  reg="${DPM_IMAGE_REGISTRY:-$(env_value DPM_IMAGE_REGISTRY)}"
  reg="${reg:-ghcr.io/in-a-bit}"
  for repo in dpm-wallet:DPM_WALLET_TAG dpm-wallet-manager:DPM_WALLET_MANAGER_TAG; do
    key="${repo#*:}"
    repo="$reg/${repo%%:*}"
    cur="$(env_value "$key")"
    prev="$(env_value "$key" .env.prev 2>/dev/null || true)"
    [ -n "$cur" ] && [ -n "$prev" ] || continue
    list="$(docker image ls --digests --format '{{.Repository}} {{.Tag}} {{.Digest}} {{.ID}}' "$repo" 2>/dev/null)" || continue
    keep_ids=" "
    while read -r r t d id; do
      [ "$r" = "$repo" ] || continue
      if prune_one_kept "$t" "$d" "$cur" "$prev"; then keep_ids="$keep_ids$id "; fi
    done <<<"$list"
    while read -r r t d id; do
      [ "$r" = "$repo" ] || continue
      prune_one_kept "$t" "$d" "$cur" "$prev" && continue
      case "$keep_ids" in *" $id "*) continue ;; esac
      image_in_use "$r" "$t" "$d" "$id" && continue
      if [ "$t" != "<none>" ]; then
        remove+=("$r:$t")
      elif [ "$d" != "<none>" ]; then
        remove+=("$r@$d")
      fi
    done <<<"$list"
  done
  [ "${#remove[@]}" -gt 0 ] || return 0
  say "Removing older images of this install: ${remove[*]}"
  docker image rm "${remove[@]}" >/dev/null 2>&1 ||
    say "  Some older images could not be removed (perhaps still in use). That is harmless."
}

cmd_upgrade() {
  local want="" yes=0 arg installed tag base target min new_wallet new_manager new_postgres answer
  for arg in "$@"; do
    case "$arg" in
      --yes | -y) yes=1 ;;
      -*) stop_unchanged "Unknown option $arg." "Usage: ./dpm-custody upgrade [version] [--yes]" ;;
      *)
        [ -z "$want" ] || stop_unchanged "Give at most one version." "Usage: ./dpm-custody upgrade [version] [--yes]"
        want="$arg"
        ;;
    esac
  done
  [ -f .env ] && [ -f compose.yml ] || stop_unchanged "This folder has no .env or compose.yml; is it a DPM custody install?"
  if [ -n "$want" ]; then
    valid_version "$want" || stop_unchanged "\"$want\" is not a version (expected something like 1.4.0)."
    tag="v${want#v}"
  else
    tag=latest
  fi
  installed="$(env_value DPM_CUSTODY_VERSION)"
  [ -n "$installed" ] || installed=unknown
  [ ! -f "$REINDEX_PENDING" ] ||
    stop_unchanged "An earlier rollback did not finish rebuilding the database's text indexes." \
      "Run ./dpm-custody start first: it finishes that with the services stopped. Then upgrade."

  take_lock
  trap on_upgrade_exit EXIT
  trap 'exit 130' INT TERM
  start_log upgrade
  UPGRADE_PHASE=checking
  if [ -f "$MARKER" ]; then
    marker_hint
    say "  ✕ So this upgrade did not start. Nothing was changed."
    exit 1
  fi

  # 1. Download and check.
  base="$(releases_base "$tag")"
  say "Downloading the release files ($base) ..."
  fetch_release "$base"
  target="$(env_value RELEASE_VERSION "$STAGE/versions.env")"
  min="$(env_value MIN_UPGRADE_FROM "$STAGE/versions.env")"
  new_wallet="$(env_value DPM_WALLET_TAG "$STAGE/versions.env")"
  new_manager="$(env_value DPM_WALLET_MANAGER_TAG "$STAGE/versions.env")"
  # Empty for a release that predates the pinned Postgres: compose.yml's own default applies.
  new_postgres="$(env_value POSTGRES_TAG "$STAGE/versions.env")"
  valid_version "$target" || stop_unchanged "The release's versions.env has no valid RELEASE_VERSION (\"$target\")."
  valid_tag "$new_wallet" && valid_tag "$new_manager" ||
    stop_unchanged "The release's versions.env has invalid image tags (\"$new_wallet\", \"$new_manager\")."
  [ -z "$new_postgres" ] || valid_tag "$new_postgres" ||
    stop_unchanged "The release's versions.env has an invalid POSTGRES_TAG (\"$new_postgres\")."
  [ -z "$min" ] || valid_version "$min" || stop_unchanged "The release's versions.env has an invalid MIN_UPGRADE_FROM (\"$min\")."
  if [ -n "$want" ] && [ "${want#v}" != "${target#v}" ]; then
    stop_unchanged "Asked for $want, but the release found at $base is $target."
  fi

  # 2. Check.
  if [ "$installed" = unknown ]; then
    say "Note: installed version unknown (this install predates version tracking). The version checks"
    say "      are skipped this once, and $target is recorded as the installed version."
  else
    valid_version "$installed" ||
      stop_unchanged "DPM_CUSTODY_VERSION in .env is not a version (\"$installed\")." \
        "Set it to the version you run, or to \"unknown\" to skip the version checks once."
    case "$(ver_cmp "$(ver_core "$target")" "$(ver_core "$installed")")" in
      0) stop_unchanged "This install already runs $installed (the release is $target)." ;;
      -1) stop_unchanged "The release ($target) is older than this install ($installed)." "To go back after an upgrade, use ./dpm-custody rollback." ;;
    esac
    if [ -n "$min" ] && [ "$(ver_cmp "$(ver_core "$installed")" "$(ver_core "$min")")" = -1 ]; then
      stop_unchanged "$target cannot be installed straight from $installed: upgrade to $min first." \
        "Run: ./dpm-custody upgrade $min   then: ./dpm-custody upgrade $target"
    fi
  fi
  if ! stack_healthy; then
    stop_unchanged "The install is not healthy right now: $(not_healthy_list)." \
      "An upgrade needs a healthy install to compare against. Check ./dpm-custody status, fix it" \
      "(or run ./dpm-custody support and send the file to the platform team), then try again."
  fi
  check_disk

  # 3. Confirm.
  say ""
  say "  Installed version: $installed"
  say "  Upgrade to:        $target"
  say "  Release notes:     $REPO_RELEASES/tag/v${target#v}"
  say "  A backup is taken first. If the new version does not come up healthy within"
  say "  $(duration "$(health_timeout)"), the previous version is put back automatically."
  say ""
  if [ "$yes" != 1 ]; then
    [ -t 0 ] || stop_unchanged "No terminal to ask in. Run it again with --yes to upgrade without the question."
    read -r -p "  Upgrade now? [y/N] " answer || answer=""
    case "$answer" in y | Y | yes | YES | Yes) ;; *) stop_unchanged "Upgrade cancelled." ;; esac
  fi
  # From here on the run finishes, rollback included, even if the terminal or SSH session goes
  # away. Docker's output goes to upgrade.log; messages go to both.
  trap '' HUP
  say "From here on this keeps running if the terminal closes. Progress: $(pwd)/upgrade.log"

  # 4. Back up.
  say "Taking a backup ..."
  if ! cmd_backup >>"$UPGRADE_LOG" 2>&1; then
    stop_unchanged "The backup failed, so the upgrade stopped (details in upgrade.log)." \
      "Check ./dpm-custody status and the free disk space, then try again."
  fi
  say "Backup saved in $(pwd)/$BACKUP_DIR"

  # 5. Pull the new images while the old ones keep running.
  say "Downloading the new images ..."
  if ! DPM_WALLET_TAG="$new_wallet" DPM_WALLET_MANAGER_TAG="$new_manager" POSTGRES_TAG="$new_postgres" \
    docker compose --env-file .env -f "$STAGE/compose.yml" --project-directory . pull >>"$UPGRADE_LOG" 2>&1; then
    stop_unchanged "Could not download the new images (details in upgrade.log)." \
      "Check the internet connection, then try again. The backup is in $(pwd)/$BACKUP_DIR."
  fi

  # 6. Keep the old files, and mark the switch as started.
  stash_prev || stop_unchanged "Could not save the previous upgrade's *.prev files (is the disk full?)."
  keep_prev || { drop_stash; stop_unchanged "Could not save the current files as *.prev (is the disk full?)."; }
  printf 'from=%s\nto=%s\nstarted=%s\n' "$installed" "$target" "$(date '+%Y-%m-%d %H:%M:%S %z')" >"$MARKER" ||
    stop_unchanged "Could not write $MARKER (is the disk full?)."

  # 7. Switch. dpm-custody is moved in last, by rename: this run keeps reading its own old file.
  UPGRADE_PHASE=switched
  say "Switching to $target ..."
  if install_file "$STAGE/compose.yml" compose.yml 644 &&
    install_file "$STAGE/versions.env" versions.env 644 &&
    set_env DPM_WALLET_TAG "$new_wallet" &&
    set_env DPM_WALLET_MANAGER_TAG "$new_manager" &&
    { [ -z "$new_postgres" ] || set_env POSTGRES_TAG "$new_postgres"; } &&
    set_env DPM_CUSTODY_VERSION "$target" &&
    install_file "$STAGE/dpm-custody" dpm-custody 755 &&
    run_migrate "$target" &&
    compose up -d >>"$UPGRADE_LOG" 2>&1 &&
    health_gate; then
    # 8. Healthy.
    UPGRADE_PHASE=done
    rm -f "$MARKER"
    drop_stash
    prune_images
    say ""
    say "  ✓ Upgraded to $target. Every service is healthy."
    say "    If something is not right, ./dpm-custody rollback goes back to $installed"
    say "    (images and files; the databases stay as they are). The backup is in $(pwd)/$BACKUP_DIR."
    say "    Once you are sure you will not go back, ./dpm-custody cleanup-legacy removes the old"
    say "    configuration volume that earlier versions used (only present if you upgraded from one)."
    say ""
    return 0
  fi

  # 8. Not healthy: roll back by itself.
  UPGRADE_PHASE=rolling-back
  say ""
  say "  ✕ $target did not come up healthy. Putting $installed back ..."
  if rollback_now; then
    UPGRADE_PHASE=done
    # Back to the files of the upgrade before this one, so `rollback` can still undo it.
    unstash_prev || say "  ! Could not put back the *.prev files of the upgrade before this one."
    rm -f "$MARKER"
    say ""
    say "  ✕ The upgrade to $target failed and was rolled back: the install runs $installed again."
    say "    The images and files are the previous ones; the rows in the databases were not restored (they do"
    say "    not need to be: a release's database changes only add). If the Postgres image changed, its text"
    say "    indexes were rebuilt for the previous one before the services started."
    say "    The backup taken before the upgrade is in $(pwd)/$BACKUP_DIR."
    say "    Run ./dpm-custody support and send the file it writes to the platform team."
    say ""
  else
    UPGRADE_PHASE=done
    print_restore_steps "$BACKUP_DIR"
    say "    The note that this upgrade did not finish stays until ./dpm-custody rollback succeeds."
  fi
  exit 1
}

# run_migrate brings the volumes up to the new layout (`setup migrate`): idempotent, and a no-op
# on an install that is already there. Setup does the same whenever it starts, so this only makes
# a failure show up here, before the new containers are created. The old config volume is mounted
# writable for this run, so scrubs of secrets reach the copy a rollback would restore. The old setup worker is stopped
# first so it cannot write to the old config volume while that is copied.
run_migrate() {
  say "Preparing the configuration volumes ..."
  compose stop setup >>"${UPGRADE_LOG:-/dev/null}" 2>&1 || true
  if ! compose run --rm --no-deps -T -e SETUP_SKIP_COLLATION=1 -v config:/legacy-config:rw setup node dist/setup/main migrate >>"${UPGRADE_LOG:-/dev/null}" 2>&1; then
    say "  ✕ Could not prepare the configuration volumes (details in upgrade.log)."
    return 1
  fi
  # That run had the old config volume writable, so its scrubs are done for the new version.
  if [ -n "${1:-}" ]; then printf '%s\n' "$1" >.legacy-scrubbed; fi
}

# ensure_legacy_scrubbed removes credentials that setup no longer needs (the bootstrap admin key,
# the admin/backend/builder keys in its state) from the OLD config volume too, which a rollback
# would otherwise bring back. The upgrade does it itself (run_migrate); this covers an upgrade run
# by an older dpm-custody, which never mounted that volume writable. It runs once per installed
# version (stamp .legacy-scrubbed) at the first command of this dpm-custody, and never fails one.
ensure_legacy_scrubbed() {
  local ver rc stamp=.legacy-scrubbed
  ver="$(env_value DPM_CUSTODY_VERSION)"
  ver="${ver:-unknown}"
  [ "$(cat "$stamp" 2>/dev/null)" = "$ver" ] && return 0
  # Nothing writes the old volume while this runs: the running setup mounts it read-only, so there
  # is no worker to stop. An image too old to know the command (exit 2) has nothing to scrub either,
  # so that counts as done for this version.
  rc=0
  compose run --rm --no-deps -T -v config:/legacy-config:rw setup node dist/setup/main scrub-legacy >/dev/null 2>&1 || rc=$?
  case "$rc" in 0 | 2) printf '%s\n' "$ver" >"$stamp" ;; esac
  return 0
}

# cmd_cleanup_legacy empties the single config volume that versions before the split used. Until
# then it is kept, because rolling back to such a version needs it. The volume is mounted
# read-only in setup, so this run mounts it writable.
cmd_cleanup_legacy() {
  local answer
  if [ "${1:-}" != --yes ] && [ "${1:-}" != -y ]; then
    echo "This empties the old configuration volume. After it, ./dpm-custody rollback can no longer"
    echo "go back to a version from before the volume split. The running install is not affected."
    [ -t 0 ] || { echo "No terminal to ask in. Run it again with --yes." >&2; return 1; }
    read -r -p "Empty it now? [y/N] " answer || answer=""
    case "$answer" in y | Y | yes | YES | Yes) ;; *) echo "Cancelled."; return 0 ;; esac
  fi
  compose run --rm --no-deps -T -v config:/legacy-config:rw setup node dist/setup/main cleanup-legacy
}

cmd_rollback() {
  local from to
  take_lock
  trap on_upgrade_exit EXIT
  trap 'exit 130' INT TERM
  start_log rollback
  have_prev || {
    say "There is nothing to roll back: compose.yml.prev, .env.prev and dpm-custody.prev are written"
    say "by an upgrade and are not all here. Nothing was changed."
    if [ -f "$MARKER" ]; then
      say "$MARKER is here although there is nothing to roll back. Check ./dpm-custody status and"
      say "upgrade.log; once every service is healthy, delete $(pwd)/$MARKER."
    fi
    exit 1
  }
  # Like an upgrade, a rollback finishes even if the terminal closes.
  trap '' HUP
  from="$(env_value DPM_CUSTODY_VERSION)"
  to="$(env_value DPM_CUSTODY_VERSION .env.prev)"
  say "Rolling back from ${from:-unknown} to ${to:-the previous version} (images and files; the databases stay as they are) ..."
  if rollback_now; then
    # After an unfinished upgrade the stash holds the upgrade before it; otherwise there is none.
    unstash_prev || say "  ! Could not put back the *.prev files of the upgrade before this one."
    rm -f "$MARKER"
    say ""
    say "  ✓ Rolled back to ${to:-the previous version}. Every service is healthy."
    say "    Note: if that version is from before the configuration volume split, it runs from the"
    say "    old config volume, which can be older than the current configuration or still hold"
    say "    secrets that newer versions removed. Upgrading again copies any change back across."
    say ""
  else
    print_restore_steps
    exit 1
  fi
}

set_env() {
  if grep -q "^$1=" .env; then
    sed -i.bak "s|^$1=.*|$1=$2|" .env && rm -f .env.bak
  else
    echo "$1=$2" >>.env
  fi
}

unset_env() {
  if grep -q "^$1=" .env; then
    sed -i.bak "/^$1=/d" .env && rm -f .env.bak
  fi
}

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$(basename "$0")"; }

# Everything runs from main, called on the last line: an upgrade replaces this file, and bash
# reads a script as it goes, so nothing may be left to read from the file once main has started.
main() {
  case "${1:-help}" in
    start | status | setup | backup | support | logs) ensure_legacy_scrubbed ;;
  esac
  case "${1:-help}" in
    start)
      # A rollback that did not finish rebuilding the indexes owes it before any service runs.
      if [ -f "$REINDEX_PENDING" ]; then
        echo "A rollback did not finish rebuilding the database's text indexes: doing that first, with the services stopped ..."
        finish_pending_reindex || exit 1
      fi
      compose up -d
      ;;
    stop) compose stop ;;
    status) compose ps; marker_hint; storage_line || true ;;
    # SETUP_PLATFORM_URL / SETUP_BUILDER_KEY, when set, answer the first two questions (still
    # checked); SETUP_INSTALL_SECONDS is how long the installer took, for the checklist.
    setup)
      rc=0
      compose exec ${SETUP_PLATFORM_URL:+-e SETUP_PLATFORM_URL} ${SETUP_BUILDER_KEY:+-e SETUP_BUILDER_KEY} \
        ${SETUP_INSTALL_SECONDS:+-e SETUP_INSTALL_SECONDS} setup node dist/setup/main setup || rc=$?
      # Setup has made the backup recovery key by now: keep its public half in .env too.
      sync_backup_recipient
      return "$rc"
      ;;
    support) cmd_support ;;
    logs) shift; compose logs --tail 200 "$@" ;;
    backup) cmd_backup ;;
    backup-key) shift; cmd_backup_key "$@" ;;
    backup-open) shift; cmd_backup_open "$@" ;;
    backup-kit) compose exec -T setup node dist/setup/main kit ;;
    upgrade) shift; cmd_upgrade "$@" ;;
    rollback) cmd_rollback ;;
    cleanup-legacy) shift; cmd_cleanup_legacy "$@" ;;
    *) usage ;;
  esac
}

main "$@"; exit
