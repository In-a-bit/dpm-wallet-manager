# ── Service ──────────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
# Exact origins the backoffice UI is served from. Comma-separated; empty disables CORS.
CORS_ORIGINS=

# ── Database ─────────────────────────────────────────────────────────────────
# The compose postgres service reads POSTGRESQL_*; DATABASE_URL is what the service uses.
# Port 5441 deliberately: dpm-wallet's own compose publishes 5440 on the same host.
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=postgres
POSTGRESQL_PORT=5441
POSTGRESQL_DB=dpm_wallet_manager
DATABASE_URL=postgres://postgres:postgres@localhost:5441/dpm_wallet_manager?sslmode=disable
# The test suite creates a throwaway database per spec on this server, so point it at a local
# instance and never at anything holding real data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5441/postgres?sslmode=disable

# ── Custody mode ─────────────────────────────────────────────────────────────
# "segregated" — every wallet holds its own funds; orders carry no recipient.
# "shared"     — the operations wallet holds all USDC; it makes every BUY and receives every SELL.
# Read at boot and burned into platform_settings the first time. Changing it afterwards does not
# migrate anything: the container refuses to start if it disagrees with the burned value.
DPM_WALLET_MANAGER_MODE=segregated

# ── Secrets ──────────────────────────────────────────────────────────────────
# 32 bytes of hex (openssl rand -hex 32). HKDF-expanded into the API-key HMAC pepper and the
# AES-256-GCM key protecting the revealable copy of each key. Lose it and every stored API key
# becomes unverifiable and unrevealable — keep it wherever the database backups are kept.
DPM_WALLET_MANAGER_MASTER_KEY=
# Optional: adopted as the first admin key when the api_keys table is empty, so an operator can
# provision from their own secret store instead of copying a printed one.
DPM_WALLET_MANAGER_BOOTSTRAP_ADMIN_KEY=
# Labels minted keys: dpmm_live_… / dpmm_test_… . 2-12 lowercase alphanumerics.
DPM_WALLET_MANAGER_KEY_ENV=live

# ── dpm-wallet (the only outbound dependency) ────────────────────────────────
DPM_WALLET_BASE_URL=http://localhost:8090
# This service's key *into* dpm-wallet — dpm-wallet's DPM_WALLET_API_KEY.
DPM_WALLET_API_KEY=
DPM_WALLET_TIMEOUT_MS=15000
# Prepended to every ref minted upstream, so one dpm-wallet can host more than one install.
WALLET_REF_PREFIX=mgr:
