{
  "name": "dpm-wallet-manager",
  "version": "0.2.0",
  "description": "Policy and directory layer in front of dpm-wallet for DPM prediction markets",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "dev:debug": "nest start --debug=9241 --watch",
    "build": "nest build",
    "build:ui": "npm --prefix ui ci && npm --prefix ui run build",
    "start": "nest start",
    "start:prod": "node dist/main",
    "typeorm": "typeorm-ts-node-commonjs -d src/db/data-source.ts",
    "db:generate": "npm run typeorm -- migration:generate",
    "db:migrate": "npm run typeorm -- migration:run",
    "db:migrate:dist": "node dist/db/migrate-cli",
    "db:revert": "npm run typeorm -- migration:revert",
    "db:check": "npm run typeorm -- migration:show",
    "keys:bootstrap": "ts-node src/api-keys/keys-bootstrap-cli.ts",
    "keys:bootstrap:dist": "node dist/api-keys/keys-bootstrap-cli",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=22"
  }
}
