{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // Matches dpm-wallet: Nest and Jest both assume CommonJS, and `bundler` resolution is what
    // makes viem readable from it — viem ships a working CommonJS build but only ESM-flavoured
    // declarations, which `nodenext` refuses from a `require` context.
    "module": "commonjs",
    "moduleResolution": "bundler",
    "types": ["node", "jest"],
    "rootDir": ".",
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "declaration": false,
    "incremental": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
